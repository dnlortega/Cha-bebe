generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guest {
  id                String   @id @default(cuid())
  nome              String
  slug              String   @unique
  status_confirmacao String?  // "CONFIRMED", "DECLINED", or null
  tipo              String   @default("INDIVIDUAL") // "INDIVIDUAL" or "FAMILIA"
  membros           String?  // Nomes dos membros da família separados por vírgula
  membros_confirmados String? // Nomes dos membros que confirmaram
  qtd_adultos       Int      @default(0)
  qtd_criancas      Int      @default(0)
  data_resposta     DateTime?
  fralda_tamanho    String?   // "RN", "P", "M", "G", "GG"
  kit_churrasco     Boolean  @default(false)
  mensagem          String?   // Recado para os pais
  giftId            String?   // ID do presente escolhido
  gift              Gift?     @relation(fields: [giftId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Settings {
  id            String @id @default("default")
  invitationUrl String @default("/convite.png")
  theme         String @default("GOLD")
  sessionTimeout Int    @default(30)
  rnQty         Int    @default(0)
  pQty          Int    @default(0)
  mQty          Int    @default(0)
  gQty          Int    @default(0)
  ggQty         Int    @default(0)
  systemFont    String @default("Inter")
  systemFontSize Int   @default(14)
  inviteFont    String @default("Playfair Display")
  inviteFontSize Int   @default(18)
  // Novos campos do evento
  eventDate     DateTime?
  eventAddress  String?
  eventMapsUrl  String?
  showInvitationImage Boolean @default(true)
}

model Gift {
  id          String   @id @default(cuid())
  name        String
  category    String?
  isReserved  Boolean  @default(false)
  guests      Guest[]
  createdAt   DateTime @default(now())
}

model Admin {
  id       String @id @default(cuid())
  username String @unique
  password String
}

