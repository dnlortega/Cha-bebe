generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  name        String   @default("Meu Evento")
  slug        String   @unique
  ownerEmail  String
  allowedEmails String[] @default([]) // <--- New whitelist field
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shareable      Boolean   @default(false)
  settings    Settings?
  guests      Guest[]
  gifts       Gift[]
  sharedWith  EventShare[]
  guestHistory GuestHistory[]
}

model EventShare {
  id          String   @id @default(cuid())
  eventId     String
  email       String
  role        String   @default("EDITOR")
  createdAt   DateTime @default(now())
  
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([eventId, email])
}

model Guest {
  id                String   @id @default(cuid())
  eventId           String   @default("default")
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  nome              String
  slug              String
  status_confirmacao String?  // "CONFIRMED", "DECLINED", or null
  tipo              String   @default("INDIVIDUAL") // "INDIVIDUAL" or "FAMILIA"
  membros           String?  // Nomes dos membros da família separados por vírgula
  membros_confirmados String? // Nomes dos membros que confirmaram
  qtd_adultos       Int      @default(0)
  qtd_criancas      Int      @default(0)
  data_resposta     DateTime?
  fralda_tamanho    String?   // "RN", "P", "M", "G", "GG"
  kit_churrasco     Boolean  @default(false)
  mensagem          String?   // Recado para os pais
  exibir_mensagem   Boolean  @default(true) // Controle de exibição do recado no mural
  giftId            String?   // ID do presente escolhido
  gift              Gift?     @relation(fields: [giftId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([eventId, slug])
}

model Settings {
  id            String @id @default("default")
  eventId       String @unique @default("default")
  event         Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitationUrl String @default("/convite.png")
  theme         String @default("GOLD")
  sessionTimeout Int    @default(30)
  rnQty         Int    @default(0)
  pQty          Int    @default(0)
  mQty          Int    @default(0)
  gQty          Int    @default(0)
  ggQty         Int    @default(0)
  systemFont    String @default("Inter")
  systemFontSize Int   @default(14)
  inviteFont    String @default("Playfair Display")
  inviteFontSize Int   @default(18)
  // Novos campos do evento
  eventDate     DateTime?
  eventAddress  String?
  eventMapsUrl  String?
  showInvitationImage Boolean @default(true)
  babyName      String?
  babyGender    String?   // "BOY", "GIRL", or "NONE"
  enableAnimations Boolean @default(true) // Toggle para ligar/desligar animações no sistema
}

model Gift {
  id          String   @id @default(cuid())
  eventId     String   @default("default")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  isReserved  Boolean  @default(false)
  guests      Guest[]
  createdAt   DateTime @default(now())
}

model Admin {
  id             String  @id @default(cuid())
  username       String  @unique
  password       String
  googleEmail    String? @unique
  status         String  @default("PENDING") // "PENDING", "APPROVED", "BLOCKED"
  allowedScreens String  @default("ALL")     // "ALL" ou lista de nomes de tela delimitados por vírgula
  avatarUrl      String?
}


model GuestHistory {
  id                String   @id @default(cuid())
  eventId           String   @default("default")
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId           String
  guestNome         String
  status_confirmacao String?  // "CONFIRMED", "DECLINED", or null
  data_resposta     DateTime @default(now())
  qtd_adultos       Int      @default(0)
  qtd_criancas      Int      @default(0)
  fralda_tamanho    String?
  kit_churrasco     Boolean  @default(false)
  mensagem          String?
  giftName          String?  // Nome do presente no momento da resposta
}

model AdminSession {
  id          String   @id @default(cuid())
  token       String   @unique
  deviceInfo  String
  deviceName  String   @default("Dispositivo Desconhecido")
  location    String   @default("Localização Desconhecida")
  gpsCoords   String?
  diagnostics String   @default("{}")
  lastActive  DateTime @default(now())
  createdAt   DateTime @default(now())
  adminEmail  String?
}

model SessionHistoryLog {
  id         String   @id @default(cuid())
  deviceName String
  deviceInfo String
  location   String
  action     String   // "INICIADA" ou "FINALIZADA"
  timestamp  DateTime @default(now())
}

